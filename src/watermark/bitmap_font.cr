# Police bitmap monospace intégrée pour le rendu du filigrane.
# Chaque glyphe fait 8 pixels de large et 16 pixels de haut.
# Les données sont stockées sous forme de 16 octets par caractère,
# chaque bit représentant un pixel (1 = allumé, 0 = éteint).
module Watermark
  module BitmapFont
    GLYPH_WIDTH  =  8
    GLYPH_HEIGHT = 16

    # Table des glyphes : caractère => tableau de 16 octets (lignes du haut vers le bas)
    GLYPHS = build_glyph_table

    # Retourne le bitmap d'un caractère, ou un rectangle plein si inconnu
    def self.glyph(char : Char) : StaticArray(UInt8, 16)
      GLYPHS[char]? || default_glyph
    end

    # Glyphe par défaut : petit rectangle pour les caractères non reconnus
    private def self.default_glyph : StaticArray(UInt8, 16)
      g = StaticArray(UInt8, 16).new(0_u8)
      g[2] = 0x7E_u8
      (3..12).each { |i| g[i] = 0x42_u8 }
      g[13] = 0x7E_u8
      g
    end

