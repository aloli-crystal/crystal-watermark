      table['\u00EE'] = sa(0x00, 0x18, 0x3C, 0x00, 0x00, 0x38, 0x18, 0x18,
        0x18, 0x18, 0x18, 0x3C, 0x00, 0x00, 0x00, 0x00)
      # ï (i tréma)
      table['\u00EF'] = sa(0x00, 0x00, 0x66, 0x00, 0x00, 0x38, 0x18, 0x18,
        0x18, 0x18, 0x18, 0x3C, 0x00, 0x00, 0x00, 0x00)
      # ÿ (y tréma)
      table['\u00FF'] = sa(0x00, 0x00, 0x66, 0x00, 0x00, 0x66, 0x66, 0x66,
        0x66, 0x66, 0x3E, 0x06, 0x06, 0x3C, 0x00, 0x00)

      # Majuscules accentuées courantes
      # É
      table['\u00C9'] = sa(0x0C, 0x18, 0x7E, 0x60, 0x60, 0x60, 0x7C, 0x60,
        0x60, 0x60, 0x60, 0x7E, 0x00, 0x00, 0x00, 0x00)
      # È
      table['\u00C8'] = sa(0x30, 0x18, 0x7E, 0x60, 0x60, 0x60, 0x7C, 0x60,
        0x60, 0x60, 0x60, 0x7E, 0x00, 0x00, 0x00, 0x00)
      # Ê
      table['\u00CA'] = sa(0x18, 0x3C, 0x7E, 0x60, 0x60, 0x60, 0x7C, 0x60,
        0x60, 0x60, 0x60, 0x7E, 0x00, 0x00, 0x00, 0x00)
      # À
      table['\u00C0'] = sa(0x30, 0x18, 0x18, 0x3C, 0x66, 0x66, 0x66, 0x7E,
        0x66, 0x66, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00)
      # Ç
      table['\u00C7'] = sa(0x00, 0x00, 0x3C, 0x66, 0x66, 0x60, 0x60, 0x60,
        0x60, 0x66, 0x66, 0x3C, 0x08, 0x18, 0x00, 0x00)

      table
    end

    # Raccourci pour créer un StaticArray(UInt8, 16) à partir de 16 valeurs
    private def self.sa(*values) : StaticArray(UInt8, 16)
      result = StaticArray(UInt8, 16).new(0_u8)
      values.each_with_index { |v, i| result[i] = v.to_u8 }
      result
    end
  end
end
